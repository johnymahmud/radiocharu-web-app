# ==============================================================================
# Radio Charu - Icecast Core Server Environment Configuration
# ==============================================================================

# Port configuration
ICECAST_PORT=8000

# Authentication & Passwords
# Used by broadcasting source software (BUTT, Mixxx, OBS, Rocket Broadcaster)
ICECAST_SOURCE_PASSWORD=CharuLiveSource2026!

# Used for stream relaying & clustering
ICECAST_RELAY_PASSWORD=CharuLiveRelay2026!

# Admin web panel credentials (http://localhost:8000)
ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=CharuAdminSecure2026!

# Capacity & Stream Buffer Tuning
ICECAST_MAX_CLIENTS=1000
ICECAST_MAX_SOURCES=10
ICECAST_BURST_SIZE=65535
ICECAST_QUEUE_SIZE=524288

# ==============================================================================
# Cloudflare Zero Trust Tunnel Configuration
# ==============================================================================
# Obtain token from dash.cloudflare.com -> Zero Trust -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_zero_trust_tunnel_token_here

# Public Live Stream & Status Endpoints
PUBLIC_STREAM_URL=https://stream.yourdomain.com/live
PUBLIC_STATUS_URL=https://stream.yourdomain.com/status-json.xsl
